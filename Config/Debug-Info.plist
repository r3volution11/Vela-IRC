<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Merged into the Info.plist Xcode generates for Debug builds (Vela Dev).
  Release builds use Vela/Info.plist, which also has Sparkle's keys: a
  development build never updates itself.
-->
<dict>
	<!-- The GIF picker's KLIPY key (Config/Vela.xcconfig). -->
	<key>VelaKLIPYAPIKey</key>
	<string>$(VELA_KLIPY_API_KEY)</string>
	<!--
	  AI servers such as Ollama or LM Studio over plain http: localhost,
	  .local names and IP addresses only (as in Vela/Info.plist).
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Vela connects to an AI server on your network only when you add one in Settings → Intelligence.</string>
</dict>
</plist>
