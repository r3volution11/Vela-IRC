<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Sparkle's settings for the in-app updater. Only the Release configuration
  uses this file (INFOPLIST_FILE); Xcode merges it with the Info.plist it
  generates from the INFOPLIST_KEY_* build settings. Debug builds ("Vela
  Dev") use Config/Debug-Info.plist instead: no update feed (their code never
  starts the updater either), and the GIF picker's KLIPY key, since GIF
  search is only in development builds for now (GIFAvailability).

  Every key is explained at https://sparkle-project.org/documentation/customization/.
  docs/RELEASING.md, "Updates", says how releases use them, and
  scripts/verify-release.sh checks them in every release.
-->
<plist version="1.0">
<dict>
	<!-- The appcast, served by velairc.app (website/public/appcast.xml). -->
	<key>SUFeedURL</key>
	<string>https://velairc.app/appcast.xml</string>
	<!--
	  The public half of the EdDSA (ed25519) key that signs each release's
	  Vela.dmg. The private half lives only in 1Password. Until it's set,
	  Vela doesn't start the updater, and scripts/release.sh and
	  scripts/verify-release.sh refuse to make a release. To set it, create
	  the key once with scripts/sparkle-key.sh, then paste the public key it
	  prints here (docs/RELEASING.md, "The update signing key").
	-->
	<key>SUPublicEDKey</key>
	<string>1gCGxe1/pzeNONyBlvvUaeXu54GGaPFCtaE9kyB63u0=</string>
	<!-- Never send a system profile; an update check sends only Sparkle's User-Agent. -->
	<key>SUEnableSystemProfiling</key>
	<false/>
	<!--
	  Never ask: Vela's own updates.checkAutomatically setting (on by
	  default) decides, and Vela applies it at launch and when it changes.
	-->
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<!-- Check once a day (in seconds). -->
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<!-- Vela is sandboxed: install through Sparkle's Installer XPC service. -->
	<key>SUEnableInstallerLauncherService</key>
	<true/>
	<!-- Check an update's EdDSA signature before unpacking it. -->
	<key>SUVerifyUpdateBeforeExtraction</key>
	<true/>
	<!--
	  Your own AI models (Settings → Intelligence → Models) can be a server
	  such as Ollama or LM Studio, which usually listens on plain http:
	  allow http to localhost, .local names and IP addresses only. Every
	  other address keeps App Transport Security's https requirement.
	  Keep in step with Config/Debug-Info.plist.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Shown when such a server is on another Mac on your network. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Vela connects to an AI server on your network only when you add one in Settings → Intelligence.</string>

	<!--
	  Automation (website/guide/automation.md). Config/Debug-Info.plist has
	  the same keys for Vela Dev, with its own link scheme.
	  - vela:// links: they only ever show things (VelaLink in VelaIntents).
	  - The AppleScript dictionary, Vela.sdef, for Alfred, Raycast and scripts.
	  - "Search in Vela" from Spotlight, for the messages Vela indexes.
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>io.github.r3volution11.Vela.link</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>vela</string>
			</array>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
		</dict>
	</array>
	<key>NSAppleScriptEnabled</key>
	<true/>
	<key>OSAScriptingDefinition</key>
	<string>Vela.sdef</string>
	<key>CoreSpotlightContinuation</key>
	<true/>
</dict>
</plist>
