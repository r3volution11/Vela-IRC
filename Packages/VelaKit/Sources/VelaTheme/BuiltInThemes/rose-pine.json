  "nickColors": [
    "#EB6F92",
    "#F6C177",
    "#EBBCBA",
    "#31748F",
    "#9CCFD8",
    "#C4A7E7",
    "#3E8FB0",
    "#D7827E",
    "#907AA9",
    "#56949F",
    "#EA9D34",
    "#B4637A"
  ],
  "ircColors": {
    "0": "#E0DEF4",
    "1": "#26233A",
    "2": "#56949F",
    "3": "#31748F",
    "4": "#EB6F92",
    "5": "#B4637A",
    "6": "#907AA9",
    "7": "#EA9D34",
    "8": "#F6C177",
    "9": "#3E8FB0",
    "10": "#D7827E",
    "11": "#EBBCBA",
    "12": "#9CCFD8",
    "13": "#C4A7E7",
    "14": "#6E6A86",
    "15": "#908CAA"
  }
}
