  "nickColors": [
    "#F28B82",
    "#F5A962",
    "#E6C76A",
    "#A8C97F",
    "#6FC2A8",
    "#6EB8D4",
    "#8DA4E8",
    "#B79AE0",
    "#E294C8",
    "#D4A88A",
    "#9CC5B8",
    "#C9B37E"
  ],
  "ircColors": {
    "0": "#F5F2EE",
    "1": "#141312",
    "2": "#6E8FD0",
    "3": "#7FAF6E",
    "4": "#FF6B5E",
    "5": "#B5785A",
    "6": "#B987D6",
    "7": "#F5A962",
    "8": "#E6C76A",
    "9": "#A8C97F",
    "10": "#4FA8A0",
    "11": "#6FD1C6",
    "12": "#6EB8D4",
    "13": "#E294C8",
    "14": "#77726C",
    "15": "#B9B4AD"
  }
}
