  "nickColors": [
    "#C2413A",
    "#B95A1A",
    "#8F6600",
    "#5A7F1F",
    "#2A7F55",
    "#0E7A85",
    "#2F64A8",
    "#4A55B5",
    "#6E48A8",
    "#9C3F94",
    "#B03A63",
    "#6B5E4E"
  ],
  "ircColors": {
    "0": "#FFFFFF",
    "1": "#16202A",
    "2": "#2B4C9B",
    "3": "#3E7D32",
    "4": "#D64545",
    "5": "#8B4A2B",
    "6": "#8E3FA0",
    "7": "#D9731A",
    "8": "#B89200",
    "9": "#6FA13A",
    "10": "#0E7A85",
    "11": "#2AA5B0",
    "12": "#2F7FD0",
    "13": "#C2408A",
    "14": "#7D8A98",
    "15": "#C3CDD7"
  }
}
