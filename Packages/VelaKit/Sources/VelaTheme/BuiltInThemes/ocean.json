  "nickColors": [
    "#F07178",
    "#F78C6C",
    "#FFCB6B",
    "#C3E88D",
    "#80CBC4",
    "#89DDFF",
    "#82AAFF",
    "#A9B4FF",
    "#C792EA",
    "#FF9CAC",
    "#DDB585",
    "#B2CCD6"
  ],
  "ircColors": {
    "0": "#EEFFFF",
    "1": "#090B10",
    "2": "#6C8EEF",
    "3": "#8FBF6A",
    "4": "#FF5370",
    "5": "#C17E70",
    "6": "#C792EA",
    "7": "#F78C6C",
    "8": "#FFCB6B",
    "9": "#C3E88D",
    "10": "#5FB3B3",
    "11": "#84FFFF",
    "12": "#82AAFF",
    "13": "#FF9CAC",
    "14": "#464B5D",
    "15": "#8F93A2"
  }
}
