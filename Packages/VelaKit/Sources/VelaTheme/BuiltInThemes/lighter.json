  "nickColors": [
    "#D32F2F",
    "#C4501F",
    "#9A6B00",
    "#5B8A1F",
    "#2E7D32",
    "#00737C",
    "#0277BD",
    "#3F6AA6",
    "#6A42D8",
    "#8150A6",
    "#C2185B",
    "#7D5F55"
  ],
  "ircColors": {
    "0": "#FFFFFF",
    "1": "#263238",
    "2": "#283593",
    "3": "#2E7D32",
    "4": "#E53935",
    "5": "#795548",
    "6": "#8E24AA",
    "7": "#EF6C00",
    "8": "#C79100",
    "9": "#7CB342",
    "10": "#00838F",
    "11": "#00ACC1",
    "12": "#1E88E5",
    "13": "#D81B60",
    "14": "#78909C",
    "15": "#B0BEC5"
  }
}
