  "nickColors": [
    "#C0392B",
    "#C0561D",
    "#9A6B00",
    "#5E7F1F",
    "#2E7D4F",
    "#0F7C80",
    "#1B6F99",
    "#3D57B0",
    "#6E44A8",
    "#A0408C",
    "#B03A5B",
    "#7D5A3C"
  ],
  "ircColors": {
    "0": "#FFFFFF",
    "1": "#2E2924",
    "2": "#2B4C9B",
    "3": "#3E7D32",
    "4": "#D64541",
    "5": "#8B4A2B",
    "6": "#8E3FA0",
    "7": "#D9731A",
    "8": "#B89200",
    "9": "#6FA13A",
    "10": "#0F7C80",
    "11": "#2AA5B0",
    "12": "#2F7FD0",
    "13": "#C2408A",
    "14": "#8C8173",
    "15": "#C9BCA8"
  }
}
