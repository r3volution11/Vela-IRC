{
  "$schema": "https://raw.githubusercontent.com/r3volution11/Vela-IRC/main/schemas/vela-theme.schema.json",
  "name": "Oceanic",
  "type": "dark",
  "author": "Vela",
  "description": "Deep blue-grey with a sea-glass teal accent, inspired by the classic Material Theme Oceanic palette.",
  "colors": {
    // Window
    "window.background": "#263238",
    "window.foreground": "#CFD8DC",
    "window.border": "#182024",
    "pane.divider": "#1C2428",

    // Title bar
    "titleBar.background": "#263238",
    "titleBar.foreground": "#EEFFFF",
    "titleBar.secondaryForeground": "#8FA4AE",
    "titleBar.border": "#1E272C",

    // Sidebar
    "sidebar.background": "#1E272C",
    "sidebar.foreground": "#B0BEC5",
    "sidebar.secondaryForeground": "#7E95A0",
    "sidebar.headerForeground": "#6F8E9A",
    "sidebar.hoverBackground": "#B0BEC512",
    "sidebar.activeBackground": "#2E4447",
    "sidebar.activeForeground": "#EEFFFF",
    "sidebar.unreadForeground": "#EEFFFF",
    "sidebar.highlightForeground": "#80CBC4",
    "sidebar.badgeBackground": "#314048",
