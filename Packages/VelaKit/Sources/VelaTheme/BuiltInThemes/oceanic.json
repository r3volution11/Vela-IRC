    "chat.timestamp": "#62808C",
    "chat.link": "#82AAFF",
    "chat.selfNick": "#80CBC4",
    "chat.highlightBackground": "#2F4548",
    "chat.highlightBorder": "#80CBC4",
    "chat.mention": "#A7E4DD",
    "chat.notice": "#F78C6C",
    "chat.action": "#C792EA",
    "chat.event": "#7F97A1",
    "chat.event.join": "#97B87F",
    "chat.event.part": "#C98A8E",
    "chat.event.quit": "#C98A8E",
    "chat.error": "#FF7B85",
    "chat.serverMessage": "#8FA4AE",
