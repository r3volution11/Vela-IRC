    "accent": "#80CBC4",
    "accentText": "#80CBC4",
    "accentForeground": "#1A2226",
    "focusBorder": "#80CBC4",
    "button.background": "#80CBC4",
    "button.foreground": "#1A2226",
    "button.hoverBackground": "#99D6D0",
    "button.secondaryBackground": "#32424A",
    "button.secondaryForeground": "#CFD8DC",
    "scrollbar.thumb": "#B0BEC530",
    "scrollbar.thumbHover": "#B0BEC555",
    "popover.background": "#2C3A41",
    "popover.foreground": "#CFD8DC",
    "popover.border": "#3B4C55",

