  "nickColors": [
    "#B58900",
    "#CB4B16",
    "#DC322F",
    "#D33682",
    "#6C71C4",
    "#268BD2",
    "#2AA198",
    "#859900",
    "#45A3E6",
    "#E8724A",
    "#E26FA6",
    "#9A9EE5"
  ],
  "ircColors": {
    "0": "#FDF6E3",
    "1": "#073642",
    "2": "#268BD2",
    "3": "#859900",
    "4": "#DC322F",
    "5": "#A6452C",
    "6": "#6C71C4",
    "7": "#CB4B16",
    "8": "#B58900",
    "9": "#A1B52A",
    "10": "#2AA198",
    "11": "#5DC2B9",
    "12": "#45A3E6",
    "13": "#D33682",
    "14": "#586E75",
    "15": "#93A1A1"
  }
}
