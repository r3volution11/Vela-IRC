    "embed.background": "#2F3347",
    "embed.border": "#3A3F58",
    "embed.accent": "#C792EA",
    "embed.title": "#82AAFF",
    "embed.description": "#A6ACCD",
    "embed.siteName": "#7E86B4",
    "embed.placeholderBackground": "#3A3F58",

