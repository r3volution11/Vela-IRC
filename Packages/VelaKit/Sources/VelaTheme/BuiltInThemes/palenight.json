    "reaction.background": "#2F3347",
    "reaction.border": "#3A3F58",
    "reaction.selfBackground": "#3D3A5E",
    "reaction.selfBorder": "#9A72C4",
    "reply.quoteBar": "#4E5579",
    "reply.foreground": "#8A91B4",
    "typing.foreground": "#8A91B4",

