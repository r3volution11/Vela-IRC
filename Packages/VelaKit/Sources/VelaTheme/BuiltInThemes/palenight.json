    "rail.background": "#1E2130",
    "rail.foreground": "#A6ACCD",
    "rail.activeIndicator": "#C792EA",

    // Chat
    "chat.background": "#292D3E",
    "chat.foreground": "#BFC7D5",
    "chat.secondaryForeground": "#8A91B4",
    "chat.timestamp": "#6C739A",
    "chat.link": "#82AAFF",
    "chat.selfNick": "#C792EA",
    "chat.highlightBackground": "#373452",
    "chat.highlightBorder": "#C792EA",
    "chat.mention": "#DDB8F5",
    "chat.notice": "#F78C6C",
    "chat.action": "#89DDFF",
    "chat.event": "#7D84AB",
    "chat.event.join": "#93B78A",
    "chat.event.part": "#C4848E",
    "chat.event.quit": "#C4848E",
    "chat.error": "#F07178",
    "chat.serverMessage": "#8A91B4",
    "chat.dayDivider": "#363A50",
    "chat.dayDividerForeground": "#8A91B4",
    "chat.unreadMarker": "#F07178",
    "chat.hoverBackground": "#A6ACCD0D",
    "chat.selectionBackground": "#717CB466",
    "chat.findMatchBackground": "#FFCB6B40",
    "chat.codeBackground": "#202331",
    "chat.codeForeground": "#C3E88D",

