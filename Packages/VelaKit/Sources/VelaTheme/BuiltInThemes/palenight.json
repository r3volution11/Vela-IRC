    "settings.background": "#292D3E",
    "settings.sidebarBackground": "#222534",
    "settings.foreground": "#BFC7D5",
    "settings.secondaryForeground": "#8A91B4",
    "settings.border": "#1F2232",
    "settings.controlBackground": "#232637"
