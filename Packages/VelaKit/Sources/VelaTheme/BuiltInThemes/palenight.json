    "input.containerBackground": "#292D3E",
    "input.background": "#232637",
    "input.foreground": "#D5DBEE",
    "input.placeholder": "#6C739A",
    "input.border": "#363A51",
    "input.focusBorder": "#C792EA",
    "input.iconForeground": "#7E86B4",

