    "#80CBC4",
    "#89DDFF",
    "#82AAFF",
    "#A9B4FF",
    "#C792EA",
    "#FF9CAC",
    "#DDB585",
    "#B2CCD6"
  ],
  "ircColors": {
    "0": "#EEFFFF",
    "1": "#1B1E2B",
    "2": "#6C8EEF",
    "3": "#8FBF6A",
    "4": "#FF5370",
    "5": "#C17E70",
    "6": "#C792EA",
    "7": "#F78C6C",
    "8": "#FFCB6B",
    "9": "#C3E88D",
    "10": "#5FB3B3",
    "11": "#89DDFF",
    "12": "#82AAFF",
    "13": "#FF9CAC",
    "14": "#676E95",
    "15": "#A6ACCD"
  }
