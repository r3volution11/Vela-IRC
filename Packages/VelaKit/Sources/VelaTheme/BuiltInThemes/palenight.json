{
  "$schema": "https://raw.githubusercontent.com/r3volution11/Vela-IRC/main/schemas/vela-theme.schema.json",
  "name": "Palenight",
  "type": "dark",
  "author": "Vela",
  "description": "Soft indigo surfaces with a lavender accent. Vela's default dark theme.",
  "colors": {
    // Window
    "window.background": "#292D3E",
    "window.foreground": "#BFC7D5",
    "window.border": "#1B1E2B",
    "pane.divider": "#1F2232",

    // Title bar
    "titleBar.background": "#292D3E",
    "titleBar.foreground": "#D5DBEE",
    "titleBar.secondaryForeground": "#8A91B4",
    "titleBar.border": "#232637",

    // Sidebar
    "sidebar.background": "#222534",
    "sidebar.foreground": "#A6ACCD",
    "sidebar.secondaryForeground": "#7A81A8",
    "sidebar.headerForeground": "#7E86B4",
    "sidebar.hoverBackground": "#A6ACCD12",
    "sidebar.activeBackground": "#3D3A5E",
    "sidebar.activeForeground": "#EEFFFF",
    "sidebar.unreadForeground": "#EEFFFF",
    "sidebar.highlightForeground": "#C792EA",
    "sidebar.badgeBackground": "#34364C",
    "sidebar.badgeForeground": "#D5DBEE",
    "sidebar.highlightBadgeBackground": "#C792EA",
    "sidebar.highlightBadgeForeground": "#1F1B2E",
    "sidebar.disconnectedForeground": "#565D82",
    "sidebar.border": "#1F2232",

