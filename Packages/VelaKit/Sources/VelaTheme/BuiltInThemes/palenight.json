    "accent": "#C792EA",
    "accentText": "#C792EA",
    "accentForeground": "#1F1B2E",
    "focusBorder": "#C792EA",
    "button.background": "#C792EA",
    "button.foreground": "#1F1B2E",
    "button.hoverBackground": "#D4A8F0",
    "button.secondaryBackground": "#363A51",
    "button.secondaryForeground": "#D5DBEE",
    "scrollbar.thumb": "#A6ACCD30",
    "scrollbar.thumbHover": "#A6ACCD55",
    "popover.background": "#2E3247",
    "popover.foreground": "#BFC7D5",
    "popover.border": "#3E4361",

